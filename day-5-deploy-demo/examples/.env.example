# Copy to .env on the server (VM). Never commit .env.
IMAGE_PREFIX=ghcr.io/<github-user>/<repo>
POSTGRES_USER=app
POSTGRES_PASSWORD=<generate-a-long-random-password>
POSTGRES_DB=appdb

# Option B only: token from Cloudflare dashboard > Zero Trust > Networks > Tunnels
# TUNNEL_TOKEN=

# Option C only: your public domain pointing at the VPS
# SITE_ADDRESS=myapp.example.com
